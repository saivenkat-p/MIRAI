# MIRAI Environment Configuration Template
# Copy this file to .env and configure local values

# Backend / API
MIRAI_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./mirai_dev.db

# Frontend / AR
VITE_API_BASE_URL=http://localhost:8000
VITE_AI_STREAM_URL=ws://localhost:8765

# AI / Vision
AI_CAMERA_INDEX=0
AI_CAMERA_WIDTH=1280
AI_CAMERA_HEIGHT=720
AI_TARGET_FPS=30
AI_SMOOTHING_FACTOR=0.7

# Hardware / Display
MIRROR_ORIENTATION=portrait
DISPLAY_WIDTH=1080
DISPLAY_HEIGHT=1920
TOUCH_INPUT_DEVICE=/dev/input/touchscreen
